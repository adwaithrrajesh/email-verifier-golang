# Email Verification System Configuration

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Worker Configuration
WORKER_COUNT=3
RATE_LIMIT_PER_DOMAIN=10

# SMTP Configuration
SMTP_TIMEOUT=15s
SMTP_USE_STARTTLS=true
SMTP_MAX_RETRIES=3
SMTP_CONNECT_TIMEOUT=10s
SMTP_READ_TIMEOUT=15s
SMTP_RETRY_DELAY=2s

# Email Sender Configuration
SMTP_FROM=noreply@mail-verifier.local

# Performance Tuning
RCPTS_PER_SESSION=40
MX_CACHE_TTL=10m

# Optional: Proxy Configuration (comma-separated list)
# PROXY_LIST=socks5://proxy1:1080,socks5://proxy2:1080

# Optional: Custom DNS Servers (comma-separated)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Monitoring (optional)
ENABLE_METRICS=false
METRICS_PORT=9091

# Development/Testing
DEV_MODE=false
LOG_LEVEL=info

# Load Testing
LOAD_TEST_CONCURRENT_USERS=50
LOAD_TEST_EMAILS_PER_USER=1000
LOAD_TEST_DURATION=5m
